{
    "name": "octoverse-id/octoreview-php",
    "description": "Official PHP SDK for Octoreview: multi-tenant reviews, ratings and review media.",
    "type": "library",
    "keywords": [
        "octoreview",
        "reviews",
        "ratings",
        "sdk",
        "api-client"
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/octoverse-id/octoreview-php",
    "support": {
        "issues": "https://github.com/octoverse-id/octoreview-php/issues",
        "source": "https://github.com/octoverse-id/octoreview-php"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Octoverse\\Octoreview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Octoverse\\Octoreview\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit --exclude-group contract",
        "contract": "phpunit --group contract",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress --memory-limit=512M"
    }
}
